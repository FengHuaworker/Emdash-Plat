---
import OpsShell from "../../layouts/OpsShell.astro";
import { env } from "cloudflare:workers";
import { isOpsAuthed } from "../../lib/ops-auth";
import { ensurePlatformTables, getQuota, quotaReasonText } from "../../lib/platform";
import { getSettings, type PlatformSettings } from "../../lib/settings";

await ensurePlatformTables();

const authed = isOpsAuthed(Astro.cookies, env as any);
const saved = Astro.url.searchParams.get("saved") === "1";

let settings: PlatformSettings = { registration: 1, announcement: "", ipHours: 24 };
let quota = { available: false, used: 0, limit: 100000, remaining: 100000, percent: 0 };
if (authed) {
	settings = await getSettings();
	quota = await getQuota();
}
---

<OpsShell title="设置" sub="注册、公告与限流；这些改动会立刻影响主站" active="settings" authed={authed}>
	{saved && (
		<div class="card" style="border-color:#1f4a2f;background:#0f1f16;color:#79d79b;margin-bottom:16px">已保存</div>
	)}

	<form method="post" action="/api/ops/settings" class="card" style="max-width:720px">
		<div class="field">
			<span>注册开关</span>
			<select name="registration">
				<option value="1" selected={settings.registration === 1}>开放注册</option>
				<option value="0" selected={settings.registration === 0}>关闭注册</option>
			</select>
			<span class="muted" style="font-size:12px">关闭后 /create 显示“暂停注册”，已有站点不受影响。</span>
		</div>

		<div class="field">
			<span>主站公告</span>
			<textarea name="announcement" rows="3" placeholder="留空表示不显示">{settings.announcement}</textarea>
			<span class="muted" style="font-size:12px">显示在首页与用户看板顶部，最多 300 字。</span>
		</div>

		<div class="field">
			<span>同一 IP 冷却（小时）</span>
			<input type="text" name="ipHours" value={settings.ipHours} />
			<span class="muted" style="font-size:12px">指同一个 IP 在多少小时内只能创建一个站点，默认 24。</span>
		</div>

		<button class="btn primary" type="submit" style="padding:10px 18px">保存设置</button>
	</form>

	<div class="card" style="max-width:720px;margin-top:16px">
		<strong style="font-size:14px">额度</strong>
		<div class="bar"><i style={`width:${quota.available ? Math.max(2, quota.percent) : 0}%`}></i></div>
		<div class="muted">
			{quota.available
				? `今日已用 ${quota.used.toLocaleString()} / ${quota.limit.toLocaleString()}（${quota.percent}%），超过 95% 自动只读`
				: quotaReasonText(quota)}
		</div>
	</div>

	<div class="card" style="max-width:720px;margin-top:16px">
		<strong style="font-size:14px">运维密码</strong>
		<p class="muted" style="margin:8px 0 0">
			来自 Worker secret <code>OPS_PASSWORD</code>，在 Cloudflare 面板或 <code>wrangler secret put OPS_PASSWORD</code> 修改，改完所有已登录会话自动失效。
		</p>
	</div>
</OpsShell>
