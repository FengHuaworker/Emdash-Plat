---
import { isPlatformHost } from "../lib/host";

// 注册 / 登录 / 我的博客都属于平台主站；租户站访问时回主站
if (!isPlatformHost(Astro.url.host)) {
	return Astro.redirect("https://yerinblog.cc.cd" + Astro.url.pathname + Astro.url.search, 302);
}
import Base from "../layouts/Base.astro";
import { db, ensurePlatformTables, getQuota, quotaReasonText, OWNER_COOKIE, type SiteRow } from "../lib/platform";
import { getSettings } from "../lib/settings";
import { getTraffic, getHostSeries, fillHourly, type TrafficPoint } from "../lib/stats";

await ensurePlatformTables();

const base = "yerinblog.cc.cd";
const owner = Astro.cookies.get(OWNER_COOKIE)?.value || "";
const rows = owner
	? (await db().prepare("SELECT * FROM platform_site WHERE owner = ?1 ORDER BY created DESC").bind(owner).all<SiteRow>()).results || []
	: [];
const quota = await getQuota();
const settings = await getSettings();
const traffic = await getTraffic();
const primaryHost = rows[0] ? `${rows[0].id}.${base}` : "";
const myTraffic = primaryHost ? traffic.byHost[primaryHost] || { today: 0, week: 0 } : { today: 0, week: 0 };
const series: TrafficPoint[] = primaryHost ? fillHourly(await getHostSeries(primaryHost, 24), 24) : [];
const seriesMax = Math.max(1, ...series.map((p) => p.count));
const ok = Astro.url.searchParams.get("ok") || "";
const error = Astro.url.searchParams.get("error") || "";

const okText: Record<string, string> = {
	password: "密码已更新，下次用新密码登录。",
	deleted: "站点已删除，地址已经释放。",
	renamed: "名称已更新。",
	domain: "域名绑定已更新。",
};
const errText: Record<string, string> = {
	nope: "这个站点不属于当前账号。",
	short: "密码至少 8 位。",
};
const domainOk = Astro.url.searchParams.get("domain") || "";
---

<Base title="我的博客" description="管理你创建的博客。">
	<section class="frame" style="padding:48px 0 88px;max-width:900px">
		<div style="display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap">
			<div>
				<p style="font-size:12px;letter-spacing:.18em;color:var(--color-text-secondary);margin:0 0 10px">DASHBOARD</p>
				<h1 style="font-size:34px;margin:0;font-weight:600;letter-spacing:-.01em">我的博客</h1>
			</div>
			<form method="post" action="/api/account" style="margin:0">
				<input type="hidden" name="action" value="logout" />
				<button type="submit" style="border:1px solid var(--color-border,rgba(0,0,0,.14));background:transparent;color:var(--color-text-secondary);border-radius:9px;padding:8px 14px;font-size:13px;cursor:pointer">退出登录</button>
			</form>
		</div>

		<p style="color:var(--color-text-secondary);font-size:14px;margin:10px 0 26px">
			这个账号下的站点都在这里；一个账号对应一个站。
		</p>

		{settings.announcement && (
			<div style="border:1px solid #c9d8f5;background:#f3f7ff;color:#2b4a86;border-radius:10px;padding:13px 16px;margin-bottom:18px;font-size:14px">
				{settings.announcement}
			</div>
		)}
		{ok && okText[ok] && (
			<div style="border:1px solid #bfe3c8;background:#f1faf3;color:#256b3a;border-radius:10px;padding:13px 16px;margin-bottom:18px;font-size:14px">
				{okText[ok]}
			</div>
		)}
		{error && errText[error] && (
			<div style="border:1px solid #f3c2c2;background:#fdf0f0;color:#a33;border-radius:10px;padding:13px 16px;margin-bottom:18px;font-size:14px">
				{errText[error]}
			</div>
		)}

		{rows.length > 0 && (
			<>
				<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px">
					<div style="border:1px solid var(--color-border,rgba(0,0,0,.1));border-radius:12px;padding:16px 18px;background:var(--color-surface)">
						<div style="font-size:26px;font-weight:600;letter-spacing:-.01em">{myTraffic.today.toLocaleString()}</div>
						<div style="font-size:12px;color:var(--color-text-secondary);margin-top:2px">今日访问（本站）</div>
					</div>
					<div style="border:1px solid var(--color-border,rgba(0,0,0,.1));border-radius:12px;padding:16px 18px;background:var(--color-surface)">
						<div style="font-size:26px;font-weight:600;letter-spacing:-.01em">{myTraffic.week.toLocaleString()}</div>
						<div style="font-size:12px;color:var(--color-text-secondary);margin-top:2px">近 7 天（本站）</div>
					</div>
					<div style="border:1px solid var(--color-border,rgba(0,0,0,.1));border-radius:12px;padding:16px 18px;background:var(--color-surface)">
						<div style="font-size:26px;font-weight:600;letter-spacing:-.01em">{traffic.ok ? traffic.today.toLocaleString() : "—"}</div>
						<div style="font-size:12px;color:var(--color-text-secondary);margin-top:2px">全平台今日</div>
					</div>
					<div style="border:1px solid var(--color-border,rgba(0,0,0,.1));border-radius:12px;padding:16px 18px;background:var(--color-surface)">
						<div style="font-size:26px;font-weight:600;letter-spacing:-.01em">{quota.available ? `${quota.percent}%` : "—"}</div>
						<div style="font-size:12px;color:var(--color-text-secondary);margin-top:2px">今日额度已用</div>
					</div>
				</div>

				{series.length > 0 && (
					<div style="border:1px solid var(--color-border,rgba(0,0,0,.1));border-radius:12px;padding:16px 18px;margin-bottom:18px;background:var(--color-surface)">
						<div style="display:flex;justify-content:space-between;font-size:12px;color:var(--color-text-secondary);margin-bottom:10px">
							<span>最近 24 小时访问</span>
							<span>峰值 {seriesMax}</span>
						</div>
						<div style="display:flex;align-items:flex-end;gap:3px;height:56px">
							{series.map((p) => (
								<div title={`${p.hour} · ${p.count}`} style={`flex:1;min-width:3px;border-radius:2px 2px 0 0;background:${p.count ? "var(--color-text)" : "rgba(0,0,0,.08)"};opacity:${p.count ? Math.max(0.25, p.count / seriesMax) : 1};height:${Math.max(4, (p.count / seriesMax) * 100)}%`}></div>
							))}
						</div>
						<div style="font-size:11px;color:var(--color-text-secondary);margin-top:8px">
							数据来自 Cloudflare 边缘日志，按小时聚合；不计后台（/_emdash）的请求。
						</div>
					</div>
				)}
			</>
		)}

		{rows.length === 0 ? (
			<div style="border:1px dashed var(--color-border,rgba(0,0,0,.16));border-radius:14px;padding:56px 24px;text-align:center">
				<p style="margin:0 0 8px;color:var(--color-text-secondary)">{owner ? "这个账号下还没有站点。" : "还没有登录。"}</p>
				<p style="margin:0 0 18px;color:var(--color-text-secondary);font-size:13px">
					{owner ? "可以创建一个新的，或者用注册时的地址和密码登录已有站点。" : "用注册时的地址和密码登录，或直接注册一个新的。"}
				</p>
				<div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
					<a href="/create" style="display:inline-block;border-radius:999px;padding:12px 24px;background:var(--color-text);color:var(--color-bg);text-decoration:none;font-size:14px">创建博客</a>
					<a href="/login" style="display:inline-block;border-radius:999px;padding:12px 24px;border:1px solid var(--color-border,rgba(0,0,0,.16));color:var(--color-text);text-decoration:none;font-size:14px">登录</a>
				</div>
			</div>
		) : (
			<ul style="list-style:none;padding:0;margin:0;display:grid;gap:14px">
				{rows.map((s) => (
					<li style="border:1px solid var(--color-border,rgba(0,0,0,.1));border-radius:14px;padding:18px 20px;background:var(--color-surface)">
						<div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
							<div>
								<div style="font-size:17px;font-weight:600">{s.title}</div>
								<div style="font-size:13px;color:var(--color-text-secondary);margin-top:4px">
									{s.id}.{base}
									<span style="margin-left:10px;padding:2px 8px;border-radius:999px;font-size:11px;background:{s.status ? "#eaf7ee" : "#fff6e5"};color:{s.status ? "#256b3a" : "#8a5a00"}">
										{s.status ? "运行中" : "已停用"}
									</span>
									<span style="margin-left:10px;font-size:12px">创建于 {new Date(s.created * 1000).toLocaleDateString("zh-CN")}</span>
								</div>
							</div>
							<div style="display:flex;gap:8px;flex-wrap:wrap">
								<a href={`https://${s.id}.${base}`} target="_blank" rel="noopener" style="border:1px solid var(--color-border,rgba(0,0,0,.14));border-radius:9px;padding:8px 14px;font-size:13px;color:var(--color-text);text-decoration:none">访问</a>
								<a href={`https://${s.id}.${base}/_emdash/admin`} target="_blank" rel="noopener" style="border-radius:9px;padding:8px 14px;font-size:13px;background:var(--color-text);color:var(--color-bg);text-decoration:none">进入后台</a>
								<button type="button" data-copy={`https://${s.id}.${base}`} style="border:1px solid var(--color-border,rgba(0,0,0,.14));background:transparent;color:var(--color-text-secondary);border-radius:9px;padding:8px 14px;font-size:13px;cursor:pointer">复制链接</button>
							</div>
						</div>

						<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px">
							<a href={`https://${s.id}.${base}/_emdash/admin/users`} target="_blank" rel="noopener" style="font-size:12px;color:var(--color-text-secondary);text-decoration:none;border-bottom:1px dashed var(--color-border,rgba(0,0,0,.2))">邀请协作者</a>
							<a href={`https://${s.id}.${base}/_emdash/admin/settings/backups`} target="_blank" rel="noopener" style="font-size:12px;color:var(--color-text-secondary);text-decoration:none;border-bottom:1px dashed var(--color-border,rgba(0,0,0,.2))">备份导出</a>
							<span style="font-size:12px;color:var(--color-text-tertiary)">在后台内完成，需要已登录该站</span>
						</div>

						{s.domain && (
							<div style="margin-top:12px;font-size:13px;color:var(--color-text-secondary)">
								自定义域名：<a href={`https://${s.domain}`} target="_blank" rel="noopener" style="color:inherit">{s.domain}</a>
							</div>
						)}

						<div style="display:flex;gap:18px;flex-wrap:wrap;margin-top:16px;padding-top:16px;border-top:1px solid var(--color-border,rgba(0,0,0,.08))">
							<form method="post" action="/api/account" style="display:flex;gap:8px;align-items:center;margin:0">
								<input type="hidden" name="id" value={s.id} />
								<input type="text" name="title" value={s.title} placeholder="站点名称" style="border:1px solid var(--color-border,rgba(0,0,0,.14));border-radius:8px;padding:7px 10px;font-size:13px;background:transparent;color:var(--color-text);width:150px" />
								<button name="action" value="rename" type="submit" style="border:1px solid var(--color-border,rgba(0,0,0,.14));background:transparent;color:var(--color-text-secondary);border-radius:8px;padding:7px 10px;font-size:12px;cursor:pointer">改名</button>
							</form>

							<form method="post" action="/api/account" style="display:flex;gap:8px;align-items:center;margin:0">
								<input type="hidden" name="id" value={s.id} />
								<input type="password" name="password" placeholder="新密码（≥8 位）" style="border:1px solid var(--color-border,rgba(0,0,0,.14));border-radius:8px;padding:7px 10px;font-size:13px;background:transparent;color:var(--color-text);width:170px" />
								<button name="action" value="password" type="submit" style="border:1px solid var(--color-border,rgba(0,0,0,.14));background:transparent;color:var(--color-text-secondary);border-radius:8px;padding:7px 10px;font-size:12px;cursor:pointer">改密</button>
							</form>

							<form method="post" action="/api/account" style="display:flex;gap:8px;align-items:center;margin:0">
								<input type="hidden" name="id" value={s.id} />
								<input type="text" name="domain" value={s.domain || ""} placeholder="自定义域名（留空解绑）" style="border:1px solid var(--color-border,rgba(0,0,0,.14));border-radius:8px;padding:7px 10px;font-size:13px;background:transparent;color:var(--color-text);width:200px" />
								<button name="action" value="domain" type="submit" style="border:1px solid var(--color-border,rgba(0,0,0,.14));background:transparent;color:var(--color-text-secondary);border-radius:8px;padding:7px 10px;font-size:12px;cursor:pointer">绑定域名</button>
							</form>

							<form method="post" action="/api/account" style="display:flex;gap:8px;align-items:center;margin:0" onsubmit="return confirm('删除后站点立刻 404，内容不可恢复，确定？')">
								<input type="hidden" name="id" value={s.id} />
								<button name="action" value="delete" type="submit" style="border:1px solid #f0c2c2;background:transparent;color:#b33;border-radius:8px;padding:7px 10px;font-size:12px;cursor:pointer">删除站点</button>
							</form>
						</div>
					</li>
				))}
			</ul>
		)}

		{traffic.ok && Object.keys(traffic.byHost).length > 0 && (
			<div style="margin-top:24px;padding:16px 18px;border:1px solid var(--color-border,rgba(0,0,0,.1));border-radius:12px;background:var(--color-surface)">
				<div style="font-size:13px;color:var(--color-text-secondary);margin-bottom:12px">今日各站访问分布</div>
				<div style="display:grid;gap:8px">
					{Object.entries(traffic.byHost)
						.sort((a, b) => b[1].today - a[1].today)
						.slice(0, 8)
						.map(([host, v]) => {
							const max = Math.max(1, ...Object.values(traffic.byHost).map((x) => x.today));
							return (
								<div style="display:grid;grid-template-columns:170px 1fr 60px;gap:10px;align-items:center;font-size:12px">
									<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--color-text-secondary)">{host}</span>
									<span style="height:6px;border-radius:3px;background:rgba(0,0,0,.06);overflow:hidden">
										<span style={`display:block;height:100%;width:${Math.max(2, (v.today / max) * 100)}%;background:var(--color-text);opacity:.7`}></span>
									</span>
									<span style="text-align:right">{v.today.toLocaleString()}</span>
								</div>
							);
						})}
				</div>
			</div>
		)}

		{domainOk && (
			<div style="margin-top:24px;padding:14px 18px;border:1px solid #c9d8f5;background:#f3f7ff;color:#2b4a86;border-radius:10px;font-size:13px;line-height:1.8">
				<strong>{domainOk}</strong> 已登记。还需要在 Cloudflare 完成两步才能真正访问：① 把该域名的 DNS 记录指向本 Worker（CNAME 到 <code>emdash-sites.workers.dev</code>，或按你的 Cloudflare 账户显示的地址）；② 在该域名的 Workers 路由里指向 <code>emdash-sites</code>。两步完成后即可用自定义域名打开博客。
			</div>
		)}

		<div style="margin-top:28px;padding:16px 18px;border:1px solid var(--color-border,rgba(0,0,0,.1));border-radius:12px">
			<div style="display:flex;justify-content:space-between;font-size:13px;color:var(--color-text-secondary);margin-bottom:8px">
				<span>平台今日额度</span>
				<span>{quota.available ? `${quota.percent}%（剩余 ${quota.remaining.toLocaleString()}）` : quotaReasonText(quota)}</span>
			</div>
			<div style="height:6px;border-radius:3px;background:rgba(0,0,0,.08);overflow:hidden">
				<div style={`height:100%;width:${quota.available ? Math.max(2, quota.percent) : 0}%;background:${quota.percent >= 95 ? "#d9534f" : "#5b7cfa"}`}></div>
			</div>
			<p style="margin:10px 0 0;font-size:12px;color:var(--color-text-secondary)">
				全平台共用免费 Worker 额度（每天 10 万次），超过 95% 会进入只读：站点仍可访问，后台暂时不能保存。
			</p>
		</div>
	</section>
	<script is:inline>
		document.addEventListener("click", function (e) {
			var btn = e.target.closest("[data-copy]");
			if (!btn) return;
			var text = btn.getAttribute("data-copy") || "";
			navigator.clipboard?.writeText(text);
			var old = btn.textContent;
			btn.textContent = "已复制";
			setTimeout(function () { btn.textContent = old; }, 1200);
		});
	</script>
</Base>
