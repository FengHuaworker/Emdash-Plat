{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdash-sites",
	"main": "./dist-sites/server/entry.mjs",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [{ "pattern": "*.yerinblog.cc.cd/*", "zone_name": "yerinblog.cc.cd" }],
	"assets": {
		"directory": "./dist-sites/client",
		"binding": "ASSETS",
		"run_worker_first": false
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash-main",
			"database_id": "b333c803-a59c-4663-a18b-e2d45cde5dbf"
		}
	],
	"kv_namespaces": [{ "binding": "SESSION", "id": "e78bc25a9c694aa185c693aad0e5b756" }],
	"durable_objects": {
		"bindings": [
			{ "name": "DB_DO", "class_name": "EmDashDB" },
			{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }
		]
	},
	"exports": {
		"EmDashDB": { "type": "durable-object", "storage": "sqlite" },
		"EmDashRoom": { "type": "durable-object", "storage": "sqlite" }
	},
	"triggers": { "crons": ["* * * * *"] }
}
